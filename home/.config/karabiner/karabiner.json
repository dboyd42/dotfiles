{
  "global": {
    "ask_for_confirmation_before_quitting": true,
    "check_for_updates_on_startup": true,
    "show_in_menu_bar": true,
    "show_profile_name_in_menu_bar": false,
    "unsafe_ui": false
  },
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,

      "complex_modifications": {
        "parameters": {
          "basic.simultaneous_threshold_milliseconds": 50,
          "basic.to_delayed_action_delay_milliseconds": 500,
          "basic.to_if_alone_timeout_milliseconds": 1000,
          "basic.to_if_held_down_threshold_milliseconds": 500
        },

        "rules": [

          {
            "description": "Caps Lock → Numeric Keypad Layer",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [
                  {
                    "set_variable": {
                      "name": "numeric_keypad_mode",
                      "value": 1
                    }
                  }
                ],
                "to_after_key_up": [
                  {
                    "set_variable": {
                      "name": "numeric_keypad_mode",
                      "value": 0
                    }
                  }
                ],
                "to_if_alone": [
                  { "key_code": "caps_lock" }
                ]
              }
            ]
          },

          {
            "description": "Numeric Keypad Layer (compact)",
            "manipulators": [

              { "type": "basic", "from": { "key_code": "u", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_7" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "i", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_8" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "o", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_9" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "p", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_hyphen" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },

              { "type": "basic", "from": { "key_code": "j", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_4" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "k", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_5" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "l", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_6" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "semicolon", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_plus" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },

              { "type": "basic", "from": { "key_code": "m", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_1" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "comma", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_2" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "period", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_3" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "slash", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_enter" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },

              { "type": "basic", "from": { "key_code": "spacebar", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_0" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "right_option", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_period" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },

              { "type": "basic", "from": { "key_code": "7", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "delete_or_backspace" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "8", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_equal_sign" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "9", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_slash" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "0", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "keypad_asterisk" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },

              { "type": "basic", "from": { "key_code": "q", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "tab" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] },
              { "type": "basic", "from": { "key_code": "w", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "delete_or_backspace" }], "conditions": [{ "type": "variable_if", "name": "numeric_keypad_mode", "value": 1 }] }

            ]
          },

          {
            "description": "UGREEN Mouse: Button 4/5 → Copy/Paste",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "pointing_button": "button5",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [
                  {
                    "key_code": "c",
                    "modifiers": ["left_command"]
                  }
                ],
                "conditions": [
                  {
                    "type": "device_if",
                    "identifiers": [
                      {
                        "vendor_id": 11145,
                        "product_id": 26145
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "pointing_button": "button4",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [
                  {
                    "key_code": "v",
                    "modifiers": ["left_command"]
                  }
                ],
                "conditions": [
                  {
                    "type": "device_if",
                    "identifiers": [
                      {
                        "vendor_id": 11145,
                        "product_id": 26145
                      }
                    ]
                  }
                ]
              }
            ]
          }

        ]
      },

      "parameters": {
        "delay_milliseconds_before_open_device": 1000
      }
    }
  ]
}
